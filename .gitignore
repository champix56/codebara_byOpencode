# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
#dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# verrous de process Chromium/Expo laissés à la racine par des outils externes
SingletonCookie
SingletonLock
SingletonSocket

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# paquets d'-assets externes (.cdz = zip binaire, hors assets Expo) — jamais versionnés
# (.cds idem : paquet de saison d'affichage, livré au serveur, cf. docs/cds-format.md)
*.cdz
*.cds

# certificats du serveur de développement (auto-signé, §HTTPS) —
# générés par scripts/generer-certificats.sh.
# cert.pem EST VERSIONNÉ volontairement : c'est la moitié PUBLIQUE de la paire
# (l'app l'embarque) et les builds EAS (local comme cloud) copient le projet
# selon .gitignore — un certificat ignoré manquerait au prebuild.
/key.pem
/champix-dev.mobileconfig
certs/
# cert.pem passe outre le motif global *.pem ci-dessus (voir commentaire).
!/cert.pem
