# Variables utilisées par les commandes Expo CLI et par la config dynamique (app.config.ts).
# Uniquement les clés préfixées EXPO_PUBLIC_ sont en plus inlinées directement dans le
# bundle JS client (règles dans docs/conventions.md).

# DEBUG=true (ici ou en shell : `DEBUG=true npx expo start`) affiche le bouton
# « Debug : passer l'authentification » de la fenêtre de connexion.
DEBUG=true
EXPO_PUBLIC_DEBUG=true
